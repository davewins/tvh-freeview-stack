# Copy to .env and edit. Never commit .env.

# --- where things live on the host ---
TZ=Europe/London
# Tvheadend settings (channels, tuner scan, DVR profile, series rules, users). BACK THIS FOLDER UP.
TVH_CONFIG_DIR=/srv/tvheadend/config
# Recordings (the .ts masters) and, inside it, the Jellyfin-friendly copies in _jellyfin/
RECORDINGS_DIR=/srv/recordings
# tvhgo's own database and cache
TVHGO_DATA_DIR=/srv/tvhgo

# --- network ---
# The address the web interfaces listen on. Use your LAN address, not 0.0.0.0, unless you put a reverse proxy in front.
LISTEN_IP=192.168.1.10
# How the other containers reach Tvheadend (the host's address works with the default bridge network)
TVH_HOST=192.168.1.10

# --- tvhgo ---
# A Tvheadend user for tvhgo (see docs/tvheadend.md for the permissions it needs)
TVHGO_TVH_USERNAME=tvhgo
TVHGO_TVH_PASSWORD=change-me
# Optional: an admin-level Tvheadend user used only to read tuner status (see docs/tvheadend.md). Empty = feature off.
TVHGO_STATUS_USERNAME=
TVHGO_STATUS_PASSWORD=
# Optional: encode live TV on the GPU: vaapi (needs the devices/group_add lines in docker-compose.yml, see docs/tvhgo.md) or cpu
TVHGO_LIVE_ENCODER=cpu
# Optional: a v3 API key from themoviedb.org for programme artwork (leave empty to disable)
TVHGO_TMDB_KEY=

# --- pipeline (the container that converts recordings, writes NFO files, finds adverts...) ---
# A Tvheadend user that may read finished recordings (see docs/tvheadend.md)
PIPELINE_TVH_USERNAME=pipeline
PIPELINE_TVH_PASSWORD=change-me
